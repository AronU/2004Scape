[queue,crypt_start_wave]
%crypt_chest_claimed = false;
switch_int (%crypt_wave) {
    case 1 : @crypt_spawn_wave1;
    case 2 : @crypt_spawn_wave2;
    case 3 : @crypt_spawn_wave3;
    case 4 : @crypt_spawn_wave4;
    case 5 : @crypt_spawn_wave5;
    case 6 : @crypt_spawn_wave6;
    case 7 : @crypt_spawn_wave7;
    case 8 : @crypt_spawn_wave8;
    case 9 : @crypt_spawn_wave9;
    case 10 : @crypt_spawn_wave10;
}

[label,crypt_spawn_wave1]
mes("Wave 1: The dead begin to rise...");
sound_synth(zombie_attack, 0, 0);
def_int $s1 = random(7);
def_int $s2 = random(7);
while ($s2 = $s1) { $s2 = random(7); }
def_int $s3 = random(7);
while ($s3 = $s1 | $s3 = $s2) { $s3 = random(7); }

npc_add(~crypt_get_spawn($s1), crypt_zombie_weak, ^max_32bit_int);
npc_add(~crypt_get_spawn($s2), crypt_zombie_weak, ^max_32bit_int);
npc_add(~crypt_get_spawn($s3), crypt_zombie_weak, ^max_32bit_int);

